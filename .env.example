# Скопируйте в .env и задайте значения: cp .env.example .env && nano .env
# .env в .gitignore — НЕ коммитить. Генерация секретов:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ── секреты (обязательно) ────────────────────────────────────────────────────────────────
JWT_SECRET=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# заполняется scripts/install.sh автоматически (пароль admin шлюза OpenFaaS)
OPENFAAS_PASSWORD=

# ── локальная разработка (python -m database.manage ..., make seed) ──────────────────────
# DATABASE_URL=postgresql://bench:<POSTGRES_PASSWORD>@127.0.0.1:5432/bench

# ── эксплуатация (не влияет на эксперимент) ──────────────────────────────────────────────
# CORS_ORIGINS=https://your-domain.example      # пусто = только same-origin
# HSTS=true                                      # только за HTTPS
# ADMIN_IPS="203.0.113.10 198.51.100.7"          # для install.sh --configure-firewall

# ── эксперимент (STAGE 2) ───────────────────────────────────────────────────────────────
# адрес целевого узла, видимый с машины генератора нагрузки
TARGET_HOST=
# машина генератора k6 (user@host) и рабочий каталог на ней
GENERATOR_SSH=
GENERATOR_WORKDIR=arch-bench-gen
PROMETHEUS_URL=http://127.0.0.1:9090
# SLA задан в experiments/configs/bench.yaml (sla.sla_ms = 500, p95). Если задать и здесь —
# значения обязаны совпасть, иначе запуск остановится.
# SLA_MS=500
